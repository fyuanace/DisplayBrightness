<UserControl x:Class="DisplayBrightness.NumericSpinBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Spin" Focusable="False" MinHeight="44">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" Background="{StaticResource CanvasBrush}"
            BorderBrush="{Binding BorderBrush, ElementName=Spin}">
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="26"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="4,0"
                     TextAlignment="Center" GotKeyboardFocus="EditorFocused"
                     AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Spin}"
                     Text="{Binding Text, ElementName=Spin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="1" Text="{Binding Suffix, ElementName=Spin}" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
            <Grid Grid.Column="2" Margin="2,2,2,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RepeatButton Style="{StaticResource StepButton}" AutomationProperties.Name="增加" Click="IncreaseClicked">
                    <Path Data="M 0,4 L 4,0 8,4" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5"/>
                </RepeatButton>
                <RepeatButton Grid.Row="1" Style="{StaticResource StepButton}" AutomationProperties.Name="减少" Click="DecreaseClicked">
                    <Path Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5"/>
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
