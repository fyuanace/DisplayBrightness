<Window x:Class="DisplayBrightness.ScheduleEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DisplayBrightness"
        Title="定时亮度" Icon="AppIcon.ico" Width="428" SizeToContent="Height" ResizeMode="NoResize"
        ContentRendered="DialogRendered" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="410">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="112" MaxWidth="138" SharedSizeGroup="FormLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="开始时间" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=HourPicker}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:NumericSpinBox x:Name="HourPicker" FontSize="18" Maximum="23" NumberFormat="D2" Wrap="True"
                                              AutomationProperties.Name="开始小时" Confirmed="SaveClicked"/>
                        <TextBlock Grid.Column="1" Text=":" FontSize="18" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <local:NumericSpinBox x:Name="MinutePicker" Grid.Column="2" FontSize="18" Maximum="59" NumberFormat="D2" Wrap="True"
                                              AutomationProperties.Name="开始分钟" Confirmed="SaveClicked"/>
                    </Grid>
                </Grid>
                <ItemsControl x:Name="BrightnessFields">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="112" MaxWidth="138" SharedSizeGroup="FormLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=BrightnessInput}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                </Label>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Value="{Binding Percent, Mode=TwoWay}" Margin="0,0,12,0"
                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0}滑条}"/>
                                    <local:NumericSpinBox x:Name="BrightnessInput" Grid.Column="1" Width="94"
                                                          FontSize="16" Suffix="%" AutomationProperties.Name="{Binding Name}"
                                                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                          Confirmed="SaveClicked"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,10" Visibility="Collapsed"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
            <Grid>
                <Button x:Name="DeleteButton" Content="删除" HorizontalAlignment="Left"
                        Background="Transparent" BorderBrush="Transparent" Padding="8,0"
                        Foreground="{StaticResource ErrorBrush}" Click="DeleteClicked"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" MinWidth="72"/>
                    <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            MinWidth="72" Margin="8,0,0,0" Click="SaveClicked"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
