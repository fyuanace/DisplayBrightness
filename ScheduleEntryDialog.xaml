<Window x:Class="DisplayBrightness.ScheduleEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DisplayBrightness"
        Title="定时亮度" Icon="AppIcon.ico" Width="428" SizeToContent="Height" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=HourPicker}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TimeChoice" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MaxDropDownHeight" Value="248"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face" CornerRadius="8" Background="{StaticResource CanvasBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <Path Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource MutedBrush}"
                                                  StrokeThickness="1.6" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" Margin="12,0,24,0"/>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"
                                       VerticalAlignment="Center" Margin="12,0,24,0"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CanvasBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="410">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="112" MaxWidth="138" SharedSizeGroup="FormLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="开始时间" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=HourPicker}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="HourPicker" Style="{StaticResource TimeChoice}" Tag="时"
                                  AutomationProperties.Name="开始小时" ItemsSource="{x:Static local:ScheduleEntryDialog.Hours}"/>
                        <TextBlock Grid.Column="1" Text=":" FontSize="18" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MinutePicker" Grid.Column="2" Style="{StaticResource TimeChoice}" Tag="分"
                                  AutomationProperties.Name="开始分钟" ItemsSource="{x:Static local:ScheduleEntryDialog.Minutes}"/>
                    </Grid>
                </Grid>
                <ItemsControl x:Name="BrightnessFields">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="112" MaxWidth="138" SharedSizeGroup="FormLabel"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=BrightnessInput}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                </Label>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Value="{Binding Percent, Mode=TwoWay}" Margin="0,0,12,0"
                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0}滑条}"/>
                                    <Border Grid.Column="1" Width="72" Height="44" CornerRadius="8" BorderThickness="1"
                                            Background="{StaticResource CanvasBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBox x:Name="BrightnessInput" Padding="8,4,23,4" BorderThickness="0"
                                                     Background="Transparent" FontSize="16" TextAlignment="Right"
                                                     AutomationProperties.Name="{Binding Name}" GotKeyboardFocus="BrightnessInputFocused"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="%" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,9,0" Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,10" Visibility="Collapsed"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
            <Grid>
                <Button x:Name="DeleteButton" Content="删除" HorizontalAlignment="Left"
                        Background="Transparent" BorderBrush="Transparent" Padding="8,0"
                        Foreground="{StaticResource ErrorBrush}" Click="DeleteClicked"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" MinWidth="72"/>
                    <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            MinWidth="72" Margin="8,0,0,0" Click="SaveClicked"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
