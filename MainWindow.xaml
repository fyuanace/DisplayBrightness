<Window x:Class="DisplayBrightness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="显示器亮度" Icon="AppIcon.ico" Width="970" Height="816" MinWidth="470" MinHeight="816"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        Closing="WindowClosing" Closed="WindowClosed">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="32" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <StackPanel Margin="24,24,24,8">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="DDC/CI  /  显示器控制" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="显示器亮度" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox x:Name="StartupToggle" Grid.Column="1" Content="开机自启"
                          Style="{StaticResource ToggleCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="登录 Windows 后直接在托盘运行" Click="StartupClicked"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新屏幕"
                        VerticalAlignment="Center" Click="RefreshClicked"/>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="定时亮度" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   ToolTip="每天在所选时间切换亮度"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="SchedulePager" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                                <Button x:Name="PreviousSchedulePage" Content="‹" MinWidth="32" Padding="0"
                                        AutomationProperties.Name="上一页定时计划" Click="SchedulePageClicked"/>
                                <TextBlock x:Name="SchedulePageLabel" Margin="6,0" VerticalAlignment="Center"/>
                                <Button x:Name="NextSchedulePage" Content="›" MinWidth="32" Padding="0"
                                        AutomationProperties.Name="下一页定时计划" Click="SchedulePageClicked"/>
                            </StackPanel>
                            <CheckBox x:Name="ScheduleToggle" Content="启用" Style="{StaticResource ToggleCheckBox}"
                                      AutomationProperties.Name="启用定时亮度" Margin="0,0,12,0" Click="ScheduleToggleClicked"/>
                            <Button x:Name="ScheduleButton" Content="＋ 添加" Padding="12,0" Click="AddScheduleClicked"/>
                        </StackPanel>
                    </Grid>
                        <ItemsControl x:Name="ScheduleList" Margin="0,10,0,0" Visibility="Collapsed"
                                      AutomationProperties.Name="定时亮度计划">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Entry}" Click="EditScheduleClicked" Margin="0,0,0,5"
                                            HorizontalContentAlignment="Stretch" Padding="12,7"
                                            Background="{StaticResource CanvasBrush}" AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Levels}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Levels}" VerticalAlignment="Center"
                                                       FontWeight="Normal" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding State}" MinWidth="42" FontSize="12" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="编辑" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="BrightnessModeHeading" Text="独立调节" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,110,0"/>
                        <CheckBox x:Name="SyncToggle" Content="同步编辑" Style="{StaticResource ToggleCheckBox}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Checked="SyncChanged" Unchecked="SyncChanged"/>
                    </Grid>
                    <Grid x:Name="SyncControls" IsEnabled="False" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="BaseControls" Margin="0,0,16,0">
                            <TextBlock x:Name="BaseValue" Text="同步基准亮度  50%" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Slider x:Name="BaseSlider" Value="50" ValueChanged="BaseChanged"
                                    AutomationProperties.Name="同步基准亮度"/>
                        </StackPanel>
                        <Button x:Name="SyncApply" Grid.Column="1" Content="应用全部并保存"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="SyncApplyClicked"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel x:Name="MonitorPager" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="PreviousMonitorPage" Content="‹" MinWidth="32" MinHeight="32" Padding="0"
                                    AutomationProperties.Name="上一页显示器" Click="MonitorPageClicked"/>
                            <TextBlock x:Name="MonitorPageLabel" Margin="6,0" VerticalAlignment="Center"/>
                            <Button x:Name="NextMonitorPage" Content="›" MinWidth="32" MinHeight="32" Padding="0"
                                    AutomationProperties.Name="下一页显示器" Click="MonitorPageClicked"/>
                        </StackPanel>
                        <TextBlock x:Name="MonitorHeading" Text="显示器" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="Cards" Tag="392" SizeChanged="CardsSizeChanged" Margin="-6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
