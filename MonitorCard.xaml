<UserControl x:Class="DisplayBrightness.MonitorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DisplayBrightness" MaxWidth="316" Margin="6,0,6,6">
    <Border Style="{StaticResource Card}" Background="{StaticResource CanvasBrush}" Padding="12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource ControlBrush}"
                        VerticalAlignment="Center">
                    <Path Width="18" Height="17" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 2,2 H 22 V 15 H 2 Z M 12,15 V 20 M 8,20 H 16"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MonitorName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="MonitorDescription" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="当前亮度" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="CurrentValue" Text="—" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <TextBlock x:Name="InputLabel" Text="亮度调节" VerticalAlignment="Center"/>
                <Grid DockPanel.Dock="Right">
                    <local:NumericSpinBox x:Name="ManualInput" Width="94" MinHeight="36" FontSize="15"
                                          Suffix="%" ConfirmOnFocusLost="True"
                                          TextChanged="InputChanged" Confirmed="ManualInputConfirmed"/>
                    <local:NumericSpinBox x:Name="CorrectionInput" Width="94" MinHeight="36" FontSize="15"
                                          Visibility="Collapsed" Minimum="-100" NumberFormat="+0;-0;0" ConfirmOnFocusLost="True"
                                          ToolTip="在基准亮度上加减百分点"
                                          TextChanged="InputChanged" Confirmed="CorrectionInputConfirmed"/>
                </Grid>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
